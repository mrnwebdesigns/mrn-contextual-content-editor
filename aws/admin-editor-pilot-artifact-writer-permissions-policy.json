{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteEncryptedImmutablePilotArtifacts",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::mrn-webdesigns-backups/deployment-artifacts/mrnwebdesigns/mrn-contextual-content-editor/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    }
  ]
}
